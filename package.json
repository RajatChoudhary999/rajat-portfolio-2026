{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "rajat-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const fs=require('fs'); if(fs.existsSync('.next')) fs.rmSync('.next', {recursive:true, force:true})\" && next dev",
    "dev:clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive:true, force:true})\" && next dev",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive:true, force:true})\"",
    "build": "next build && node -e \"const fs=require('fs'); if(fs.existsSync('.next') && !fs.existsSync('.next/fallback-build-manifest.json')) fs.writeFileSync('.next/fallback-build-manifest.json', '{}')\"",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "lottie-react": "^3.1.2",
    "motion": "^14.11.1",
    "next": "^15.5.29",
    "postcss": "^8.5.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
